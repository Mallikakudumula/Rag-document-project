# mock = no API needed (extractive answers). anthropic / openai = real LLM answers.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DOCS_DIR=data/docs
INDEX_PATH=data/index.json
CHUNK_WORDS=120
CHUNK_OVERLAP=25
TOP_K=4
MIN_SCORE=1.0
MIN_COVERAGE=0.34
USE_EMBEDDINGS=false
